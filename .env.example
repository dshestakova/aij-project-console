NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Серверная LLM для смысловой классификации и заполнения заявок.
# Поддерживается OpenAI-compatible endpoint, например https://api.gpt.mws.ru/v1.
APPLICATION_LLM_ENABLED=true
APPLICATION_LLM_BASE_URL=
APPLICATION_LLM_API_KEY=
APPLICATION_LLM_MODEL=
APPLICATION_LLM_TIMEOUT_MS=120000
# Если используется MWS AI, достаточно MWS_API_KEY: endpoint и модель
# по умолчанию будут https://api.gpt.mws.ru/v1 и mts-anya.
MWS_API_KEY=

PASSPORT_FILLER_ENABLED=true
PASSPORT_FILLER_BASE_URL=http://176.123.166.195
PASSPORT_FILLER_API_PREFIX=/api
PASSPORT_FILLER_API_TOKEN=
PASSPORT_FILLER_TIMEOUT_MS=30000
PASSPORT_FILLER_RETRY_COUNT=2
