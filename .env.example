NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Серверный GigaChat для классификации и заполнения заявок.
# Тот же набор переменных, что в splat / vsp_pulse. Ключ только server-side.
APPLICATION_LLM_ENABLED=true
GIGACHAT_CREDENTIALS=
# Альтернативное имя ключа (gigaoutlook / vsp_pulse):
# GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_TIMEOUT_SECONDS=120
GIGACHAT_TEMPERATURE=0.11
GIGACHAT_PROFANITY_CHECK=false
GIGACHAT_MAX_RETRIES=2
GIGACHAT_TOKEN_REFRESH_MARGIN_SECONDS=60
# На Windows часто нужен false из-за корпоративного TLS / Russian Trusted CA.
GIGACHAT_VERIFY_SSL_CERTS=false

PASSPORT_FILLER_ENABLED=true
PASSPORT_FILLER_BASE_URL=http://176.123.166.195
PASSPORT_FILLER_API_PREFIX=/api
PASSPORT_FILLER_API_TOKEN=
PASSPORT_FILLER_TIMEOUT_MS=30000
PASSPORT_FILLER_RETRY_COUNT=2
